# Private key of a Base mainnet wallet holding a little USDC (no ETH needed).
# Paid tools cost $0.002 to $0.02 per call. 0x-prefixed, 64 hex chars.
# Use a separate wallet with small funds.
BUYER_PRIVATE_KEY=

# Refuse any single payment above this many USD. Defaults to 0.05.
MAX_USD_PER_CALL=0.05

# The only origin this server pays. Defaults to the live base-gas-x402 API.
BASE_GAS_ORIGIN=

# Base Builder Code attached to the x402 payment payload for attribution.
# Defaults to bc_lhfd8zad if unset.
BUILDER_CODE=bc_lhfd8zad
