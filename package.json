    "mcp-server"
  ],
  "author": "memosr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memosr/base-gas-mcp.git"
  },
  "homepage": "https://github.com/memosr/base-gas-mcp#readme",
